TELEGRAM_BOT_TOKEN=
AUTHORIZED_USER_ID=
BRMS_API_URL=http://localhost:5001
AGENT_SECRET_KEY=
AGENT_REVIEW_WORKER_ID=review-verifier
AGENT_WHATSAPP_WORKER_ID=whatsapp-campaign
REVIEW_VERIFY_POLL_SECONDS=10
WHATSAPP_POLL_SECONDS=10
REVIEW_VERIFY_RETRY_SECONDS=60
WHATSAPP_RETRY_SECONDS=60
AMAZON_CHROME_PROFILE_DIR=/absolute/path/to/chrome_data_amazon
WHATSAPP_CHROME_PROFILE_DIR=/absolute/path/to/chrome_data_whatsapp

LLM_BACKEND=llama_cpp
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=local-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
MAX_TOOL_STEPS=6

SEARCH_MAX_RESULTS=3

UI_STEALTH_MODE=applescript_then_cursor
CONFIRM_SEND=false
AUTO_SEND_WITHOUT_CONFIRM=true
AUTO_CONTACT_CONFIRM=false
MAX_MESSAGE_LENGTH=1000
ALLOWED_APPS=whatsapp,slack,imessage,messages

VLM_ENABLED=false
VLM_CLI_PATH=/opt/homebrew/bin/llama-mtmd-cli
VLM_MODEL=
VLM_MMPROJ=
VLM_CONFIDENCE_THRESHOLD=0.4
VLM_MAX_CANDIDATES=25
VLM_MAX_DIM=640
